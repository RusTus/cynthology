[Unit]
Description=Cynthology: unlock encrypted shared folders whose key is stored on the NAS
After=local-fs.target
Before=smbd.service nfs-server.service cynthology-ui.service

[Service]
Type=oneshot
WorkingDirectory=/opt/cynthology/backend
Environment=CYN_STATE=/var/lib/cynthology
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 -m cynthology.storage assemble-at-boot
ExecStartPre=/usr/lib/cynthology/wait-volumes
ExecStart=/usr/bin/python3 -m cynthology.shares unlock-at-boot
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
