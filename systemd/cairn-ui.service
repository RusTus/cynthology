[Unit]
Description=CairnOS web management (port 5000)
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Environment=CAIRN_STATE=/var/lib/cairn
WorkingDirectory=/opt/cairnos/backend
ExecStart=/usr/bin/python3 -m uvicorn cairn.main:app --host 0.0.0.0 --port 5000
Restart=on-failure

[Install]
WantedBy=multi-user.target
