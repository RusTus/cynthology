[Unit]
Description=Cynthology web management (HTTP 5000, HTTPS 5001)
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Environment=CYN_STATE=/var/lib/cynthology
WorkingDirectory=/opt/cynthology/backend
ExecStart=/usr/bin/python3 -m cynthology.serve
Restart=on-failure

[Install]
WantedBy=multi-user.target
