#!/bin/sh
# Cynthology shim for DSM's synopkg (subset used by package scripts)
cmd="$1"; pkg="$2"
case "$cmd" in
  start|stop|restart) exec systemctl "$cmd" "cyn-pkg-$pkg" ;;
  status|is_onoff) systemctl is-active --quiet "cyn-pkg-$pkg" && { echo "package $pkg is turned on"; exit 0; } || { echo "package $pkg is turned off"; exit 1; } ;;
  version) sed -n 's/^version="\(.*\)"/\1/p' "/var/packages/$pkg/INFO" ;;
  list) ls /var/packages ;;
  *) echo "synopkg shim: '$cmd' not supported on Cynthology" >&2; exit 1 ;;
esac
